# Secrets/tokens the shell picks up as environment variables.
#
# install.sh copies this file to ~/.config/zsh/exports.zsh — a copy, not a
# symlink, so that one sits outside the repo and real values can't be committed
# by accident. Fill in values there, never here.
#
# Every line stays commented out so a fresh install needs no follow-up: the
# shell works as-is, and you uncomment one in the copy when you actually need it.

# export NUGET_AUTH_TOKEN=
